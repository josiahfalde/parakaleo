modules = ["python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["cargo", "freetype", "glibcLocales", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssh", "openssl", "pkg-config", "rustc", "tcl", "tk", "zlib", "sqlite"]

[deployment]
deploymentTarget = "autoscale"
run = ["streamlit", "run", "app.py", "--server.port", "5000"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Streamlit Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WebSocket Server"

[[workflows.workflow]]
name = "Streamlit Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 5000 --server.address 0.0.0.0"
waitForPort = 5000

[[workflows.workflow]]
name = "ParakaleoMed Server"
author = 43790207
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 5000"

[[workflows.workflow]]
name = "WebSocket Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python websocket_server.py"
waitForPort = 6789

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6789
externalPort = 3000

[[ports]]
localPort = 36793
externalPort = 3003

[[ports]]
localPort = 37709
externalPort = 5000

[[ports]]
localPort = 39685
externalPort = 4200

[[ports]]
localPort = 41343
externalPort = 3002

[[ports]]
localPort = 41921
externalPort = 3001
